<?xml version="1.0" encoding="utf-8"?><!--
    Smart Wash Counter — the OPERATOR'S ONE SCREEN, arranged to match the Compose app.

    FOUR TABS, NOT FOUR DOORS [GA, 18 Sep 2026]. The four lists used to be four cards under the
    toolbar that each STARTED SOMETHING: two relaunched this activity with a flag, two opened a
    second activity. Four lists of the same rows, reachable only by leaving the screen you were
    on — and the operator's whole job is comparing them. A TabLayout is the platform's own answer
    to what the Compose app draws as a tab strip, so the two apps now hold the same shape.

    PLATFORM, NOT PAINT. The Compose screen is liquid glass over a wallpaper; this is the house
    card-and-toolbar vocabulary. What is matched is the ARRANGEMENT: title and subtitle at the top
    with search and refresh beside them, the tab strip under it, the date range only on the
    archive, the list filling the rest, and the hand-in door as a floating button in the bottom-
    left corner.

    ONE LIST, EVERY MODE. `rvList` is still the only RecyclerView and the adapter is still swapped,
    which is what makes four tabs plus a bundle affordable: a second list would be a second empty
    state and a second scroll position, times five.

    WHO SCANS WHAT [GA via Rosita Secoadi, 12 Sep 2026]: the courier scans the counter sticker and
    stops there; scanning the garments is this screen's job.

    SAVE MAY BE PRESSED MORE THAN ONCE for the same arrival: thirty garments is a long time to
    hold a phone steady, and the server takes them in stages rather than one perfect pass.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- TITLE, SUBTITLE AND TWO ACTIONS, like the Compose header. The subtitle is what tells the
         four tabs apart in words - "Masuk" alone does not say whether these are couriers waiting
         or garments arriving - and it changes with the tab, as it does over there.

         SEARCH AND REFRESH IN THE TOOLBAR, which is where an XML app puts an action; the Compose
         app has no toolbar to put them in and draws them as glass circles instead. Same two
         controls, same order, each platform's own furniture. -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolBar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/white"
        android:elevation="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@drawable/baseline_arrow_back_ios_new_24">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/laundry_counter_title"
                    android:textColor="@color/black"
                    android:textSize="@dimen/text_size_medium"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/laundry_counter_subtitle"
                    android:textColor="@color/custom_toast_font_normal_gray"
                    android:textSize="@dimen/text_size_small" />
            </LinearLayout>

            <ImageView
                android:id="@+id/searchButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/laundry_search_hint"
                android:padding="8dp"
                android:src="@drawable/baseline_search_24" />

            <ImageView
                android:id="@+id/refreshButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="@string/laundry_refresh"
                android:padding="8dp"
                android:src="@drawable/refresh_icon" />
        </LinearLayout>
    </androidx.appcompat.widget.Toolbar>

    <!-- ABOVE THE TABS, because it filters whichever one is open - one query, four lists. Hidden
         until asked for: the operator searches on the day the queue is long, not on the twenty
         days it holds two rows. -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/searchField"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/list_item_submission_margin_horizontal"
        android:layout_marginTop="8dp"
        android:hint="@string/laundry_search_hint"
        android:visibility="gone"
        app:boxCornerRadiusBottomEnd="@dimen/login_field_corner_radius"
        app:boxCornerRadiusBottomStart="@dimen/login_field_corner_radius"
        app:boxCornerRadiusTopEnd="@dimen/login_field_corner_radius"
        app:boxCornerRadiusTopStart="@dimen/login_field_corner_radius"
        app:boxStrokeColor="@color/black"
        app:boxStrokeWidth="@dimen/login_field_stroke_width"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolBar"
        tools:visibility="visible">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLength="120"
            android:textSize="@dimen/text_size_medium" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- The four flows, in the Compose order: what arrived, what is washing, what is ready, what
         is done. Scrollable because "Completed" in English is wider than a quarter of a small
         phone, and a clipped tab label is worse than a strip that slides. -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/searchField"
        app:tabGravity="fill"
        app:tabIndicatorColor="@color/button_color"
        app:tabIndicatorFullWidth="false"
        app:tabMode="scrollable"
        app:tabSelectedTextColor="@color/black"
        app:tabTextColor="@color/custom_toast_font_normal_gray" />

    <!-- ONLY ON THE ARCHIVE, exactly as in Compose: the other three lists are today's work, and a
         date range on them is a control that can only ever hide something still to be dealt
         with. -->
    <LinearLayout
        android:id="@+id/rangeRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tabLayout"
        tools:visibility="visible">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/fromButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginVertical="@dimen/list_item_submission_margin_horizontal"
            android:layout_marginStart="@dimen/list_item_submission_margin_horizontal"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            app:cardCornerRadius="@dimen/login_button_corner_radius"
            app:cardElevation="@dimen/card_elevation"
            app:strokeWidth="0dp">

            <TextView
                android:id="@+id/fromText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:paddingVertical="10dp"
                android:text="@string/laundry_date_from"
                android:textColor="@color/black"
                android:textSize="@dimen/text_size_small"
                android:textStyle="bold" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/toButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/list_item_submission_margin_horizontal"
            android:layout_marginVertical="@dimen/list_item_submission_margin_horizontal"
            android:layout_weight="1"
            app:cardCornerRadius="@dimen/login_button_corner_radius"
            app:cardElevation="@dimen/card_elevation"
            app:strokeWidth="0dp">

            <TextView
                android:id="@+id/toText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:paddingVertical="10dp"
                android:text="@string/laundry_date_to"
                android:textColor="@color/black"
                android:textSize="@dimen/text_size_small"
                android:textStyle="bold" />
        </com.google.android.material.card.MaterialCardView>

        <!-- NOT `clearButton`: that id already belongs to the one that empties a bundle, and two
             views with one name in a binding is a bug that compiles. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/rangeClearButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginVertical="@dimen/list_item_submission_margin_vertical"
            android:layout_marginEnd="@dimen/list_item_submission_margin_horizontal"
            android:visibility="gone"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="0dp"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/gradient_rejected_color"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:contentDescription="@string/laundry_date_clear"
                    android:padding="8dp"
                    android:src="@drawable/baseline_close_24"
                    app:tint="@color/white" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- Step 1 · whose bundle this is. Bundle mode only; on the four lists there is nothing being
         served yet. -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/arrivalCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/list_item_submission_margin_horizontal"
        android:layout_marginTop="8dp"
        android:visibility="gone"
        app:cardBackgroundColor="#FBFBFB"
        app:cardCornerRadius="@dimen/list_item_progress_card_corner_radius"
        app:cardElevation="@dimen/list_item_progress_card_elevation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rangeRow"
        app:strokeWidth="0dp"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginVertical="@dimen/dialog_message_margin_vertical"
                android:layout_marginStart="@dimen/dropdown_item_padding_horizontal"
                android:layout_marginEnd="@dimen/card_corner_radius"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/laundry_serving_label"
                    android:textColor="@color/custom_toast_font_normal_gray"
                    android:textSize="@dimen/text_size_small" />

                <TextView
                    android:id="@+id/tvServing"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/laundry_no_courier_selected"
                    android:textColor="@color/black"
                    android:textSize="@dimen/text_size_medium"
                    android:textStyle="bold"
                    tools:text="Budi Santoso · Produksi" />

                <TextView
                    android:id="@+id/tvServingTrxNo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textColor="@color/custom_toast_font_normal_gray"
                    android:textSize="@dimen/text_size_small"
                    android:visibility="gone"
                    tools:text="2026/09/12/LDY/0001"
                    tools:visibility="visible" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/pickCourierButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginVertical="@dimen/dialog_message_margin_vertical"
                android:layout_marginEnd="@dimen/dropdown_item_padding_horizontal"
                app:cardCornerRadius="@dimen/login_button_corner_radius"
                app:cardElevation="@dimen/card_elevation"
                app:strokeWidth="0dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:background="@drawable/gradient_accent_color"
                    android:gravity="center"
                    android:paddingHorizontal="@dimen/button_padding"
                    android:paddingVertical="@dimen/dropdown_item_padding_vertical"
                    android:text="@string/laundry_pick_courier"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_size_medium"
                    android:textStyle="bold" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Step 2 · the bundle. Hidden on the lists, where the count and the clear button would both
         be describing something that is not on screen. -->
    <TextView
        android:id="@+id/tvBundleCount"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/list_item_submission_margin_horizontal"
        android:textColor="@color/black"
        android:textSize="@dimen/text_size_medium"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/clearButton"
        app:layout_constraintEnd_toStartOf="@+id/clearButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/clearButton"
        tools:text="12 item" />

    <!-- The cancel gradient, not the accent one: emptying the list is the destructive action on
         this screen and must not look like the one that saves it. -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/clearButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="@dimen/list_item_submission_margin_horizontal"
        android:visibility="gone"
        app:cardCornerRadius="@dimen/login_button_corner_radius"
        app:cardElevation="@dimen/list_item_progress_card_elevation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/arrivalCard"
        app:strokeWidth="0dp"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/button_padding"
            android:paddingVertical="@dimen/dialog_margin"
            tools:ignore="UseCompoundDrawables">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center_vertical"
                android:src="@drawable/clear_icon"
                tools:ignore="ContentDescription" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/card_corner_radius"
                android:gravity="center"
                android:text="@string/laundry_clear_bundle"
                android:textColor="@color/black"
                android:textSize="@dimen/text_size_medium"
                android:textStyle="bold" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Whichever of the five lists is open. The adapter is swapped, not the view. -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvList"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/fab_size"
        app:layout_constraintBottom_toTopOf="@+id/noteField"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/clearButton"
        tools:itemCount="3"
        tools:listitem="@layout/list_item_laundry_queue" />

    <LinearLayout
        android:id="@+id/emptyContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        app:layout_constraintBottom_toTopOf="@+id/noteField"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/clearButton"
        tools:visibility="gone">

        <!-- The house empty state, same animation the task and submission lists use. The line of
             text under it carries the tab: five empty lists look identical otherwise, and they
             call for different things. -->
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/emptyAnimation"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="@dimen/login_logo_margin"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"
            app:lottie_rawRes="@raw/empty_list_animation" />

        <TextView
            android:id="@+id/tvEmptyMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="@string/laundry_queue_empty"
            android:textColor="@color/custom_toast_font_normal_gray"
            android:textSize="@dimen/text_size_medium" />
    </LinearLayout>

    <!-- HAND IN, AS A FLOATING BUTTON IN THE BOTTOM-LEFT CORNER, which is where the Compose app
         puts it. Counter staff wear uniforms and hand them in like anybody else, so their screen
         carries a door to the courier one - the menu routes on role and would otherwise leave
         them no entrance. It was one of four cards under the toolbar, which is where a primary
         action goes to be mistaken for a setting.

         Bottom-START, not end: the other hand is holding a garment. -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/fabHandIn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:contentDescription="@string/laundry_hand_in_action"
        app:cardCornerRadius="@dimen/login_button_corner_radius"
        app:cardElevation="@dimen/card_elevation"
        app:contentPadding="@dimen/button_padding"
        app:layout_constraintBottom_toTopOf="@+id/noteField"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/delivery_icon" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Step 3 · the hand-over note and save. -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/noteField"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/list_item_submission_margin_horizontal"
        android:layout_marginBottom="8dp"
        android:hint="@string/laundry_batch_note_hint"
        android:visibility="gone"
        app:boxCornerRadiusBottomEnd="@dimen/login_field_corner_radius"
        app:boxCornerRadiusBottomStart="@dimen/login_field_corner_radius"
        app:boxCornerRadiusTopEnd="@dimen/login_field_corner_radius"
        app:boxCornerRadiusTopStart="@dimen/login_field_corner_radius"
        app:boxStrokeColor="@color/black"
        app:boxStrokeWidth="@dimen/login_field_stroke_width"
        app:expandedHintEnabled="true"
        app:layout_constraintBottom_toTopOf="@+id/footerButtonContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:visibility="visible">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etBatchNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionDone"
            android:inputType="text"
            android:maxLength="2000"
            android:textSize="@dimen/text_size_medium" />
    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
        android:id="@+id/footerButtonContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/submitButton"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height"
            android:layout_marginHorizontal="@dimen/list_item_submission_margin_horizontal"
            android:layout_marginVertical="@dimen/list_item_submission_margin_horizontal"
            android:layout_weight="1"
            android:visibility="gone"
            app:cardCornerRadius="@dimen/login_button_corner_radius"
            app:cardElevation="@dimen/card_elevation"
            app:strokeWidth="0dp"
            tools:visibility="visible">

            <ProgressBar
                android:id="@+id/submitLoadingBar"
                android:layout_width="@dimen/login_progress_bar_size"
                android:layout_height="match_parent"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="8dp"
                android:indeterminateTint="@color/white"
                android:visibility="gone"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/submitText"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/gradient_accent_color"
                android:gravity="center"
                android:text="@string/laundry_submit"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_medium"
                android:textStyle="bold" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/fabScanPatch"
            android:layout_width="@dimen/button_height"
            android:layout_height="@dimen/button_height"
            android:layout_marginVertical="@dimen/list_item_submission_margin_horizontal"
            android:layout_marginEnd="@dimen/list_item_submission_margin_horizontal"
            android:visibility="gone"
            app:cardCornerRadius="@dimen/dialog_corner_radius"
            app:cardElevation="@dimen/card_elevation"
            app:contentPadding="12dp"
            app:strokeColor="@color/black"
            app:strokeWidth="1dp"
            tools:visibility="visible">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/qr_scan_icon"
                tools:ignore="ContentDescription" />
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
