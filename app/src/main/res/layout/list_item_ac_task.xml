<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/list_item_submission_margin_horizontal"
    android:layout_marginVertical="@dimen/list_item_submission_margin_vertical"
    app:cardBackgroundColor="#FBFBFB"
    app:cardCornerRadius="@dimen/list_item_progress_card_corner_radius"
    app:cardElevation="@dimen/list_item_progress_card_elevation"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/gradient_notification_color"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/list_item_submission_header_padding_horizontal"
            android:paddingVertical="@dimen/list_item_submission_header_padding_vertical"
            tools:ignore="UselessParent">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvScheduleName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_size_medium"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toStartOf="@+id/tvStatus"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:text="Monthly Maintenance" />

                <TextView
                    android:id="@+id/tvAcCode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_size_micro"
                    android:textStyle="bold"
                    tools:text="AC.EMR/HOL.LT1-001" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="@dimen/list_item_submission_tag_card_corner_radius"
                app:cardElevation="0dp"
                app:cardPreventCornerOverlap="false"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:id="@+id/statusColor"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingHorizontal="@dimen/list_item_submission_tag_content_padding_horizontal"
                    android:paddingVertical="@dimen/list_item_submission_tag_content_padding"
                    tools:background="@drawable/gradient_on_progress_color">

                    <TextView
                        android:id="@+id/statusText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/white"
                        android:textSize="@dimen/text_size_micro"
                        android:textStyle="bold"
                        tools:text="Pending" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- One LinearLayout per row, not three parallel label/colon/value columns. The old
             shape made a row impossible to hide: the label, colon and value lived in
             different parents, so a null value left an orphan label behind. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/list_item_submission_machine_info_padding_horizontal"
            android:paddingVertical="@dimen/list_item_submission_description_padding_vertical">

            <include
                android:id="@+id/rowLocation"
                layout="@layout/partial_ac_task_row"
                tools:visibility="visible" />

            <include
                android:id="@+id/rowDetail"
                layout="@layout/partial_ac_task_row" />

            <include
                android:id="@+id/rowArea"
                layout="@layout/partial_ac_task_row" />

            <include
                android:id="@+id/rowFloor"
                layout="@layout/partial_ac_task_row" />

            <include
                android:id="@+id/rowBrand"
                layout="@layout/partial_ac_task_row" />

            <include
                android:id="@+id/rowModel"
                layout="@layout/partial_ac_task_row" />

            <include
                android:id="@+id/rowCapacity"
                layout="@layout/partial_ac_task_row" />

            <include
                android:id="@+id/rowTechnician"
                layout="@layout/partial_ac_task_row" />

            <include
                android:id="@+id/rowLastMaintenance"
                layout="@layout/partial_ac_task_row" />
        </LinearLayout>

        <!-- Supervisor's brief for the schedule. Free text, so it gets its own full-width block
             instead of a label:value row, and stays hidden unless the schedule has one. -->
        <LinearLayout
            android:id="@+id/noteBlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/list_item_submission_machine_info_padding_horizontal"
            android:layout_marginBottom="@dimen/list_item_submission_description_padding_vertical"
            android:background="#FFF8E1"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/list_item_submission_description_padding_horizontal"
            android:paddingVertical="@dimen/list_item_submission_description_padding_vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/schedule_note"
                android:textColor="#8A6D00"
                android:textSize="@dimen/text_size_micro"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvScheduleNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/black"
                android:textSize="@dimen/text_size_small"
                tools:text="Bawa tangga, unit berada di plafon tinggi." />
        </LinearLayout>

        <TextView
            android:id="@+id/tvDeadline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/list_item_submission_description_padding_horizontal"
            android:paddingBottom="@dimen/list_item_submission_description_padding_vertical"
            android:textColor="#D32F2F"
            android:textSize="@dimen/text_size_small"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvArea"
            tools:text="Deadline: 2024-05-01" />
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
