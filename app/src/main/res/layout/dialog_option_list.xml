<?xml version="1.0" encoding="utf-8"?><!--
    Pick one of a few things — a condition, a collector, a printer.

    THE CONFIRMATION DIALOG'S CARD with rows instead of a message. The rows are added at runtime
    because the lists are two to eight items long and each one is a different shape of thing; a
    RecyclerView and an adapter for eight rows that never scroll is machinery for its own sake.

    ONE BUTTON, AND IT CANCELS. Picking a row IS the confirmation — a second tap to agree with the
    tap you just made is how somebody ends up choosing the wrong printer twice.
-->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/dialogContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/dialog_margin"
        android:layout_marginVertical="@dimen/dialog_margin"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="@dimen/dialog_corner_radius"
        app:cardElevation="@dimen/dialog_elevation"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/titleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/activity_horizontal_margin"
                android:layout_marginVertical="@dimen/dialog_message_margin_vertical"
                android:textAlignment="center"
                android:textColor="@color/black"
                android:textSize="@dimen/text_size_medium"
                android:textStyle="bold"
                tools:text="Siapa yang mengambil?" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="@dimen/dialog_divider_height"
                app:cardBackgroundColor="@color/custom_toast_font_normal_soft_gray"
                app:cardElevation="0dp"
                app:strokeWidth="0dp" />

            <!-- Scrolls only when it has to: a collector list from a big department can outgrow
                 the screen, and a dialog taller than the phone has no cancel button. -->
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxHeight="@dimen/dialog_option_list_max_height">

                <LinearLayout
                    android:id="@+id/optionContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="@dimen/dialog_divider_height"
                app:cardBackgroundColor="@color/custom_toast_font_normal_soft_gray"
                app:cardElevation="0dp"
                app:strokeWidth="0dp" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cancelButton"
                android:layout_width="match_parent"
                android:layout_height="@dimen/toolbar_height"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="0dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="@string/cancel_confirmation"
                    android:textColor="@color/custom_toast_font_failed"
                    android:textSize="@dimen/text_size_small"
                    android:textStyle="bold" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</RelativeLayout>
