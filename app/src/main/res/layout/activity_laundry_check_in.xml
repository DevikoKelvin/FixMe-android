<?xml version="1.0" encoding="utf-8"?><!--
    Kedatangan Laundry — the COURIER, and one scan is their whole job.

    ONE ACTION ON THE WHOLE SCREEN. GA split check-in on 12 Sep 2026 [via Rosita Secoadi]: the
    courier scans the counter sticker, and the counter operator scans the uniforms on their own
    phone. So everything the old version of this screen had — the bundle list, the patch scanner,
    the clear button, the hand-over note — moved to activity_laundry_counter.xml, and what is left
    is a button and the confirmation it produces.

    NO COUNTER LOOKUP FIRST. laundryArrive checks the sticker and the department itself and answers
    in one round trip, so calling laundryCounter beforehand would be a second request to learn what
    the first one already says.

    HOUSE WIDGETS THROUGHOUT: no MaterialButton and no FloatingActionButton anywhere in this app —
    a button is a MaterialCardView holding a gradient background and a centred TextView.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolBar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/white"
        android:elevation="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@drawable/baseline_arrow_back_ios_new_24">

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/laundry_check_in_title"
            android:textColor="@color/black"
            android:textSize="@dimen/text_size_medium"
            android:textStyle="bold" />
    </androidx.appcompat.widget.Toolbar>

    <!-- Before the scan: what to do, and nothing else. -->
    <LinearLayout
        android:id="@+id/instructionContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        app:layout_constraintBottom_toTopOf="@+id/scanCounterButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolBar"
        tools:visibility="gone">

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/instructionAnimation"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="@dimen/login_logo_margin"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"
            app:lottie_rawRes="@raw/empty_list_animation" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="@string/laundry_arrive_instruction"
            android:textColor="@color/custom_toast_font_normal_gray"
            android:textSize="@dimen/text_size_medium" />
    </LinearLayout>

    <!-- After the scan: the transaction number, which is what the operator will call out. Left on
         screen rather than finishing the activity, because a courier who walks away and is then
         asked "which number?" has nothing to show otherwise. -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/arrivalCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/list_item_submission_margin_horizontal"
        android:visibility="gone"
        app:cardBackgroundColor="#FBFBFB"
        app:cardCornerRadius="@dimen/list_item_progress_card_corner_radius"
        app:cardElevation="@dimen/list_item_progress_card_elevation"
        app:layout_constraintBottom_toTopOf="@+id/scanCounterButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolBar"
        app:strokeWidth="0dp"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/laundry_arrival_registered"
                android:textColor="@color/custom_toast_font_normal_gray"
                android:textSize="@dimen/text_size_small" />

            <TextView
                android:id="@+id/tvTrxNo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="@color/black"
                android:textSize="@dimen/text_size_large"
                android:textStyle="bold"
                tools:text="2026/09/12/LDY/0001" />

            <TextView
                android:id="@+id/tvArrivalMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/black"
                android:textSize="@dimen/text_size_medium"
                tools:text="Serahkan seragam ke petugas counter untuk dipindai." />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/scanCounterButton"
        android:layout_width="0dp"
        android:layout_height="@dimen/button_height"
        android:layout_marginHorizontal="@dimen/list_item_submission_margin_horizontal"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="@dimen/login_button_corner_radius"
        app:cardElevation="@dimen/card_elevation"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:strokeWidth="0dp">

        <TextView
            android:id="@+id/scanCounterText"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/gradient_accent_color"
            android:gravity="center"
            android:text="@string/laundry_scan_counter"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size_medium"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/scanLoadingBar"
            android:layout_width="@dimen/login_progress_bar_size"
            android:layout_height="match_parent"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="8dp"
            android:indeterminateTint="@color/white"
            android:visibility="gone"
            tools:visibility="visible" />
    </com.google.android.material.card.MaterialCardView>
</androidx.constraintlayout.widget.ConstraintLayout>
