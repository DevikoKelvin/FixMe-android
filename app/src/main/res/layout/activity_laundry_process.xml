<?xml version="1.0" encoding="utf-8"?><!--
    One batch, and everything the counter does to it — ported from the Compose app, 17 Sep 2026.

    ONE STAGE, ONE ACTION ROW. The five actions are stages of the same batch and only ever one of
    them is legal at a time, so the screen shows the batch and offers the stage it is actually at.
    A column of five buttons, four of them refusals waiting to happen, is the same information
    arranged to be got wrong.

    THE HOUSE VOCABULARY, NOT MATERIAL'S DEFAULTS [17 Sep 2026]. The header is a card like the
    batch screen's, the primary action is a gradient card like Collect and Submit, the secondary is
    a plain card like Clear, and the empty state is the same Lottie every other list uses. This
    screen arrived with `MaterialButton` and a bare TextView, which is a different app's design
    language on a screen sitting one tap from the counter queue.

    THE SCREEN DECIDES NOTHING. Every rule — who may accept, what a note is compulsory for, whether
    a batch may be signed off — is in `LaundryProcess` on the server, which the web screens call
    too. What this knows is which button to show.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolBar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/surface"
        android:elevation="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@drawable/baseline_arrow_back_ios_new_24">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/laundry_process_title"
            android:textColor="@color/ink"
            android:textSize="@dimen/text_size_medium"
            android:textStyle="bold" />
    </androidx.appcompat.widget.Toolbar>

    <!-- The batch, in the same card the courier's batch screen opens with. -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/headerCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/list_item_submission_margin_horizontal"
        android:layout_marginTop="16dp"
        app:cardCornerRadius="@dimen/list_item_progress_card_corner_radius"
        app:cardElevation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolBar"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/gradient_card_color"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/dropdown_item_padding_horizontal"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTrxNo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textColor="@color/ink"
                    android:textSize="@dimen/text_size_large"
                    android:textStyle="bold"
                    tools:text="2026/09/17/LDY/0001" />

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/ink"
                    android:textSize="@dimen/text_size_medium"
                    android:textStyle="bold"
                    tools:text="Sedang dicuci" />

                <!-- Only while verifying: the count the Accept button exists for. A bundle that
                     does not match is the case the override was written for, and the operator
                     should see that before pressing anything. -->
                <TextView
                    android:id="@+id/tvProgress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/custom_toast_font_normal_gray"
                    android:textSize="@dimen/text_size_small"
                    android:visibility="gone"
                    tools:text="1 dari 2 diperiksa"
                    tools:visibility="visible" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/printButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/dropdown_item_padding_horizontal"
                android:visibility="gone"
                app:cardCornerRadius="@dimen/card_corner_radius"
                tools:visibility="visible">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:contentDescription="@string/laundry_print_slip"
                    android:padding="8dp"
                    android:src="@drawable/print_icon" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/actionRow"
        app:layout_constraintTop_toBottomOf="@+id/headerCard">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvItems"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="@dimen/dropdown_item_padding_horizontal"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            tools:itemCount="3"
            tools:listitem="@layout/list_item_laundry_process_line" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- The house empty state, same animation every other list in this app uses. -->
    <LinearLayout
        android:id="@+id/emptyContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/swipeRefreshLayout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/swipeRefreshLayout"
        tools:visibility="gone">

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/emptyAnimation"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="@dimen/login_logo_margin"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"
            app:lottie_rawRes="@raw/empty_list_animation" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="@string/laundry_batch_empty"
            android:textColor="@color/custom_toast_font_normal_gray"
            android:textSize="@dimen/text_size_medium" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/actionRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/tvSelected"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/list_item_submission_margin_horizontal"
            android:paddingBottom="6dp"
            android:textColor="@color/custom_toast_font_normal_gray"
            android:textSize="@dimen/text_size_small"
            android:visibility="gone"
            tools:text="2 dipilih"
            tools:visibility="visible" />

        <!-- The secondary action of the current stage: scanning a garment in, or recording what
             came out of the machine. A plain card, like Clear on the counter screen — it must not
             look like the one that moves the batch on. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/secondaryButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginHorizontal="@dimen/list_item_submission_margin_horizontal"
            android:visibility="gone"
            app:cardCornerRadius="@dimen/login_button_corner_radius"
            app:cardElevation="@dimen/list_item_progress_card_elevation"
            app:strokeWidth="0dp"
            tools:visibility="visible">

            <TextView
                android:id="@+id/secondaryText"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textColor="@color/ink"
                android:textSize="@dimen/text_size_medium"
                android:textStyle="bold"
                tools:text="Periksa seragam" />
        </com.google.android.material.card.MaterialCardView>

        <!-- The one that moves the batch on: accept, start the wash, sign it off, hand it over. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/primaryButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginHorizontal="@dimen/list_item_submission_margin_horizontal"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            app:cardCornerRadius="@dimen/login_button_corner_radius"
            app:cardElevation="@dimen/card_elevation"
            app:strokeWidth="0dp"
            tools:visibility="visible">

            <ProgressBar
                android:id="@+id/primaryLoadingBar"
                android:layout_width="@dimen/login_progress_bar_size"
                android:layout_height="match_parent"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="8dp"
                android:indeterminateTint="@color/white"
                android:visibility="gone" />

            <TextView
                android:id="@+id/primaryText"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/gradient_accent_color"
                android:gravity="center"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_medium"
                android:textStyle="bold"
                tools:text="Siap diambil" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Tolak: the only way out that is not forwards, and the Supervisor's alone
             [GA, 21 Sep 2026]. The cancel gradient, not the accent one, for the same reason
             Kosongkan wears it on the counter screen: this ends the courier's trip.

             BELOW the primary rather than beside it. On the web the two sit side by side as peer
             decisions, but a phone row of two full-width buttons is where a thumb lands on the
             wrong one - and the wrong one here sends a bundle home. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/rejectButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginHorizontal="@dimen/list_item_submission_margin_horizontal"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="@dimen/list_item_submission_margin_horizontal"
            android:visibility="gone"
            app:cardCornerRadius="@dimen/login_button_corner_radius"
            app:cardElevation="@dimen/card_elevation"
            app:strokeWidth="0dp"
            tools:visibility="visible">

            <TextView
                android:id="@+id/rejectText"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/gradient_rejected_color"
                android:gravity="center"
                android:text="@string/laundry_reject"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_medium"
                android:textStyle="bold" />
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
