<?xml version="1.0" encoding="utf-8"?><!--
    One garment scanned back OUT at the counter, before the bundle may be handed over.

    A CODE AND NOTHING ELSE, and that is the honest shape. The scan-out is a completeness check:
    the operator is counting the bundle against what the server says is collectable, not judging
    anything. Resolving each code against the master register would say whether the garment EXISTS,
    which is not the question - whether it belongs to THIS batch is, and only the server can answer
    that. It does, on submit, and it names the offender.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/list_item_submission_margin_horizontal"
    android:layout_marginVertical="@dimen/list_item_submission_margin_vertical"
    app:cardBackgroundColor="@color/surface_card"
    app:cardCornerRadius="@dimen/list_item_progress_card_corner_radius"
    app:cardElevation="@dimen/list_item_progress_card_elevation"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvOrdinal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:textColor="@color/custom_toast_font_normal_gray"
            android:textSize="@dimen/text_size_medium"
            tools:text="1." />

        <TextView
            android:id="@+id/tvCode"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:textColor="@color/ink"
            android:textSize="@dimen/text_size_large"
            android:textStyle="bold"
            tools:text="000123" />

        <!-- A mis-scan has to be removable, or the operator restarts a bundle of thirty because
             the camera read one tag twice from a different angle. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/removeButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            app:cardBackgroundColor="@color/custom_toast_background_warning"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="@string/laundry_remove_scan"
                android:textColor="@color/custom_toast_font_warning"
                android:textSize="@dimen/text_size_small"
                android:textStyle="bold" />
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
